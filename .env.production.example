APP_NAME="Última Milla Express"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ultimamilla.deploytive.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ultimamilla_reservas
DB_USERNAME=ultimamilla
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Email queda en log hasta que el cliente confirme uso
MAIL_MAILER=log
MAIL_FROM_ADDRESS="reportes@ultimamilla.deploytive.com"
MAIL_FROM_NAME="Última Milla Express"

# Vacío hasta que se active Resend en futuro
RESEND_API_KEY=

# Email destino del resumen diario (cuando se active)
ADMIN_EMAIL_RESUMEN=admin@ultimamilla.test

# Horizon
HORIZON_PREFIX=ultimamilla:

# Filesystem
FILESYSTEM_DISK=local

# Trusted proxies (Hetzner LB / Cloudflare si se usa después)
TRUSTED_PROXIES=*
