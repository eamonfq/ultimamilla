APP_NAME="UltimaMilla Express"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ultimamilla.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ultimamilla_express
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="reportes@ultimamilla.deploytive.com"
MAIL_FROM_NAME="${APP_NAME}"

# Produccion cambia a:
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxx

RESEND_API_KEY=

ADMIN_EMAIL_RESUMEN="admin@ultimamilla.test"

VITE_APP_NAME="${APP_NAME}"
